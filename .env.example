# Documentation only -- the demo runs from exported shell variables; you do not
# need a .env file. If you do create one (copy this to .env), it is loaded as a
# convenience and never overrides variables already set in your shell.

# Your Azure AI Foundry project endpoint.
AZURE_AI_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>

# The name of the chat-capable model deployment in that project.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o

# Auth is DefaultAzureCredential: run `az login` locally, or rely on a managed
# identity when hosted. No key goes in this file.
